# -------------------------------
# Core Python excludes
# -------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb

# Virtual environments
venv/
env/
.venv/
.python-version
pip-wheel-metadata/

# -------------------------------
# Node/Yarn/NPM (future-proof)
# -------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------
# Operating System files
# -------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.cache/
.cache/**

# -------------------------------
# Editors / IDEs
# -------------------------------

# VSCode
.vscode/
.history/
.code-workspace

# JetBrains
.idea/
*.iml

# -------------------------------
# Devctl specific
# -------------------------------

# Local environment files (do NOT commit secrets)
.env
env/*.env

# Temporary droplet fetch/cache files
tmp.json
tmp_droplet.txt
*.tmp
*.temp
*.bak

# Billing cache
billing*.json

# Python core logs
logs/
*.log

# SSH configs (user-specific)
*.pem
*.pub
*.key
*.ppk
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Installer outputs
*.exe
*.msi
*.pkg
*.deb
*.rpm

# Bundled zip or release artifacts
devctl.zip
*.zip
*.tar.gz

# Distribution / packaging (future)
dist/
build/
target/
release/

# Coverage and test artifacts (future)
.coverage
coverage.xml
htmlcov/

# -------------------------------
# Git / Repo hygiene
# -------------------------------
.gitignore~
*.swp
*.swo
